{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cgrtml/reasongate",
  "title": "ReasonGate",
  "description": "Provenance gateway for stdio MCP servers: blocks tool calls fed by untrusted tool results.",
  "version": "0.6.1",
  "repository": {
    "url": "https://github.com/cgrtml/reasongate",
    "source": "github"
  },
  "websiteUrl": "https://github.com/cgrtml/reasongate",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "reasongate",
      "version": "0.6.1",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "--",
          "description": "Separates gateway options from the wrapped server command."
        },
        {
          "type": "positional",
          "valueHint": "server_command",
          "description": "The MCP server to run behind the gate, e.g. npx -y @modelcontextprotocol/server-filesystem /path",
          "isRequired": true,
          "isRepeated": true
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
